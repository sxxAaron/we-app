# 用 python3 manage.py init-env --domain weight.example.com 自动生成真正的 .env。
# 不要把本示例的密钥用在生产环境。
SETUP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
DOMAIN=weight.example.com
# 无域名时：使用 init-env --ip 公网IPv4 生成配置，而不是手动照抄本示例。
SERVER_IP=
PUBLIC_ORIGIN=https://weight.example.com
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
APP_PORT=18765
